{
  "name": "nineonenine-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "check": "npm run lint && npm run build && npm run check:seo",
    "check:runtime": "node scripts/check-runtime.mjs",
    "check:security": "npm audit --audit-level=low",
    "check:seo": "node scripts/check-seo.mjs",
    "dev": "next dev",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix",
    "prepare": "husky",
    "start": "next start"
  },
  "overrides": {
    "tailwindcss": {
      "postcss-selector-parser": "7.1.6"
    }
  },
  "dependencies": {
    "@formspree/react": "^3.0.0",
    "@headlessui/react": "^2.2.9",
    "@heroicons/react": "^2.1.3",
    "next": "^16.3.4",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "husky": "9.1.7",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.1",
    "ultracite": "7.11.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
